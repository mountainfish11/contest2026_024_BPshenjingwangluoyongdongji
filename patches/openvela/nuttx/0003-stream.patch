---
 arch/xtensa/src/esp32s3/esp32s3_wlan.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/arch/xtensa/src/esp32s3/esp32s3_wlan.c b/arch/xtensa/src/esp32s3/esp32s3_wlan.c
index a78783b27df..287e1cae8f8 100644
--- a/arch/xtensa/src/esp32s3/esp32s3_wlan.c
+++ b/arch/xtensa/src/esp32s3/esp32s3_wlan.c
@@ -29,6 +29,7 @@
 #include <assert.h>
 #include <errno.h>
 #include <stdio.h>
+#include <unistd.h>
 #include <debug.h>
 #include <arpa/inet.h>
 
@@ -61,6 +62,7 @@
 /* TX timeout = 1 minute */
 
 #define WLAN_TXTOUT               (60 * CLK_TCK)
+#define WLAN_TX_PACE_US           2000
 
 /* Low-priority work queue processes RX/TX */
 
@@ -559,14 +561,14 @@ static void wlan_transmit(struct wlan_priv_s *priv)
 
           wlan_free_buffer(priv, pktbuf->buffer);
 
-          /* The Wi-Fi driver reports completion asynchronously.  Submit
-           * one frame at a time and let wlan_tx_done() schedule the next
-           * one instead of filling the vendor TX queue in a tight loop.
+          /* Avoid filling the vendor TX queue in a tight loop.  A short
+           * yield preserves forward progress even if a completion callback
+           * is delayed or coalesced.
            */
 
           if (ret >= 0)
             {
-              break;
+              usleep(WLAN_TX_PACE_US);
             }
         }
     }
