+                 info.fordblks, info.mxordblk, info.uordblks);
+        }
+      else if (ret >= 0 && tx_nomem_active)
+        {
+          struct mallinfo info = kmm_mallinfo();
+
+          tx_nomem_active = false;
+          printf("[wlan-tx] recovered heap free=%u largest=%u used=%u\n",
