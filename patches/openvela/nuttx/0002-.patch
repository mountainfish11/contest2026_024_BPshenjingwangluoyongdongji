+                       (uintptr_t)priv->fb + priv->fb_alloc);
+
+  if (priv->pixfmt == IMGDATA_PIX_FMT_JPEG)
+    {
+      bool found_soi = false;
+
+      data_size = 0;
+      for (i = 0; i + 1 < priv->fb_alloc; i++)
+        {
+          if (!found_soi && priv->fb[i] == 0xff && priv->fb[i + 1] == 0xd8)
