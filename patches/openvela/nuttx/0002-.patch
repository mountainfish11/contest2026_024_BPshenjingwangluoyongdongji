             break;
 
           case WIFI_ADPT_EVT_AP_STACONNECTED:
@@ -6016,6 +6027,20 @@ int esp_wifi_softap_start(void)
       goto errout;
     }
 
+  /* Cache the complete SoftAP defaults before accepting WEXT updates.
+   * AP_START is delivered asynchronously, so relying on its event handler
+   * leaves a window where an ESSID update copies the zero-initialized cache
+   * back to the Wi-Fi driver (including max_connection and beacon fields).
+   */
+
+  ret = esp_wifi_get_config(WIFI_IF_AP, &g_softap_wifi_cfg);
+  if (ret)
+    {
+      wlerr("Failed to get Wi-Fi SoftAP config ret=%d\n", ret);
+      ret = wifi_errno_trans(ret);
+      goto errout;
+    }
+
   g_softap_started = true;
 
   wlinfo("OK to start Wi-Fi SoftAP\n");
