+            ret = esp32s3_wlan_softap_set_linkstatus(true);
+            if (ret < 0)
+              {
+                wlerr("ERROR: Failed to set Wi-Fi SoftAP link status\n");
+              }
             break;
 
           case WIFI_ADPT_EVT_AP_STOP:
             wlinfo("INFO: Wi-Fi softap stop\n");
+            ret = esp32s3_wlan_softap_set_linkstatus(false);
+            if (ret < 0)
+              {
