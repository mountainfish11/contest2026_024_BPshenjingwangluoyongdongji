+static uint64_t esp32s3_cam_time_diff_us(const struct timeval *end,
+                                         const struct timeval *start)
+{
+  int64_t sec;
+  int64_t usec;
+
+  sec = end->tv_sec - start->tv_sec;
+  usec = end->tv_usec - start->tv_usec;
+  usec += sec * 1000000;
+  return usec < 0 ? 0 : (uint64_t)usec;
+}
+
+static void esp32s3_cam_prepare_slot(struct esp32s3_cam_s *priv,
+                                     struct esp32s3_cam_slot_s *slot)
+{
+  memset(slot->fb, 0, priv->fb_alloc);
+  esp32s3_cam_setup_dma(priv, slot);
+  up_clean_dcache((uintptr_t)slot->fb,
+                  (uintptr_t)slot->fb + priv->fb_alloc);
+}
+
+static uint32_t
+esp32s3_cam_dma_received(struct esp32s3_cam_s *priv,
+                         struct esp32s3_cam_slot_s *slot)
+{
+  uint32_t received = 0;
+  uint32_t total_desc;
+  uint32_t i;
+
+  total_desc = (priv->fb_alloc + ESP32S3_CAM_DMA_BUFLEN - 1) /
+               ESP32S3_CAM_DMA_BUFLEN;
+
+  for (i = 0; i < total_desc && i < ESP32S3_CAM_DMADESC_NUM; i++)
+    {
+      uint32_t ctrl = slot->dmadesc[i].ctrl;
+      uint32_t length;
+
+      if ((ctrl & ESP32S3_DMA_CTRL_OWN) != 0)
+        {
+          break;
+        }
+
+      length = (ctrl >> ESP32S3_DMA_CTRL_DATALEN_S) &
+               ESP32S3_DMA_CTRL_DATALEN_V;
+      if (length == 0)
+        {
+          break;
+        }
+
+      received += length;
+    }
+
+  return received > priv->fb_alloc ? priv->fb_alloc : received;
+}
+
+static int esp32s3_cam_start_slot(struct esp32s3_cam_s *priv,
+                                  struct esp32s3_cam_slot_s *slot)
+{
+  irqstate_t flags;
+  uint32_t regval;
+
+  if (slot->fb == NULL)
+    {
+      return -EINVAL;
+    }
+
+  esp32s3_cam_prepare_slot(priv, slot);
+
+  flags = spin_lock_irqsave(&priv->lock);
+  if (!priv->streaming || priv->capturing ||
+      slot->state != ESP32S3_CAM_SLOT_FREE)
+    {
+      spin_unlock_irqrestore(&priv->lock, flags);
+      return -EBUSY;
+    }
+
+  regval = getreg32(LCD_CAM_CAM_CTRL1_REG);
+  regval &= ~LCD_CAM_CAM_START_M;
+  putreg32(regval, LCD_CAM_CAM_CTRL1_REG);
+
+  regval |= LCD_CAM_CAM_RESET_M;
+  putreg32(regval, LCD_CAM_CAM_CTRL1_REG);
+  regval &= ~LCD_CAM_CAM_RESET_M;
+  putreg32(regval, LCD_CAM_CAM_CTRL1_REG);
+
+  regval |= LCD_CAM_CAM_AFIFO_RESET_M;
+  putreg32(regval, LCD_CAM_CAM_CTRL1_REG);
+  regval &= ~LCD_CAM_CAM_AFIFO_RESET_M;
+  putreg32(regval, LCD_CAM_CAM_CTRL1_REG);
+
+  esp32s3_dma_reset_channel(priv->dma_channel, false);
+  esp32s3_dma_load(slot->dmadesc, priv->dma_channel, false);
+  esp32s3_dma_enable(priv->dma_channel, false);
+
+  regval = getreg32(LCD_CAM_CAM_CTRL_REG);
+  regval |= LCD_CAM_CAM_UPDATE_REG_M;
+  putreg32(regval, LCD_CAM_CAM_CTRL_REG);
+
+  gettimeofday(&slot->arm_ts, NULL);
+  regval = getreg32(LCD_CAM_CAM_CTRL1_REG);
+  regval |= LCD_CAM_CAM_START_M;
+  putreg32(regval, LCD_CAM_CAM_CTRL1_REG);
+
+  priv->active_slot = slot->index;
+  priv->vsync_cnt = 0;
+  slot->state = ESP32S3_CAM_SLOT_CAPTURING;
+  priv->capturing = true;
+
+  esp32s3_gpio_matrix_in(CONFIG_ESP32S3_CAM_VSYNC_PIN,
+                         CAM_V_SYNC_IDX, false);
+  up_udelay(10);
+  esp32s3_gpio_matrix_in(CONFIG_ESP32S3_CAM_VSYNC_PIN,
+                         CAM_V_SYNC_IDX, true);
+
+  /* The GPIO-matrix pulse above synchronizes LCD_CAM to the beginning of a
+   * new software frame.  Account for that pulse here so the next physical
+   * VSYNC completes the frame.  Waiting for two additional physical VSYNCs
+   * discards a full sensor period on every capture.
+   */
+
+  putreg32(LCD_CAM_CAM_VSYNC_INT_CLR_M,
+           LCD_CAM_LC_DMA_INT_CLR_REG);
+  gettimeofday(&slot->first_vsync_ts, NULL);
+  priv->vsync_cnt = 1;
+
+  spin_unlock_irqrestore(&priv->lock, flags);
+  return OK;
+}
