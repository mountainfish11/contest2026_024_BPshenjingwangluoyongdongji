From 3b52522ac5834bb36c1cadd2fe56de4839d478a6 Mon Sep 17 00:00:00 2001
From: mountainfish11 <1096913405@qq.com>
Date: Sun, 1 Nov 2026 01:14:51 +0800
Subject: [PATCH 7/9] esp32s3-eye: add DN Wi-Fi control with manual vision
 start

---
 arch/xtensa/src/esp32s3/Kconfig               |  9 +++
 arch/xtensa/src/esp32s3/Make.defs             |  2 +
 arch/xtensa/src/esp32s3/esp32s3_adc.c         | 57 +++++++++++++++++--
 arch/xtensa/src/esp32s3/esp32s3_sdmmc.c       | 19 +++----
 .../esp32s3-eye/configs/blindbadge/defconfig  | 10 ++++
 .../esp32s3/esp32s3-eye/src/esp32s3_boot.c    | 33 -----------
 .../esp32s3/esp32s3-eye/src/esp32s3_bringup.c | 40 +++++++++++++
 7 files changed, 122 insertions(+), 48 deletions(-)

diff --git a/arch/xtensa/src/esp32s3/Kconfig b/arch/xtensa/src/esp32s3/Kconfig
index 42a21caf434..baffbc91020 100644
--- a/arch/xtensa/src/esp32s3/Kconfig
+++ b/arch/xtensa/src/esp32s3/Kconfig
@@ -2688,6 +2688,15 @@ config ESP32S3_SDMMC_DMA
 	select SDIO_DMA
 	default y
 
+config ESP32S3_SDMMC_FREQUENCY
+	int "SD/MMC transfer frequency"
+	depends on ESP32S3_SDMMC
+	range 400000 40000000
+	default 20000000
+	help
+		SD/MMC transfer frequency in Hz.  Boards with long traces or weak
+		signal integrity can select a lower value.
+
 config ESP32S3_SDMMC_CMD
 	int "CMD GPIO"
 	depends on ESP32S3_SDMMC
diff --git a/arch/xtensa/src/esp32s3/Make.defs b/arch/xtensa/src/esp32s3/Make.defs
index 566c815d5e1..ea075f36e3d 100644
--- a/arch/xtensa/src/esp32s3/Make.defs
+++ b/arch/xtensa/src/esp32s3/Make.defs
@@ -107,6 +107,8 @@ endif
 
 ifeq ($(CONFIG_ESP32S3_ADC),y)
 CHIP_CSRCS += esp32s3_adc.c
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)hal$(DELIM)adc_hal_common.c
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)hal$(DELIM)adc_oneshot_hal.c
 endif
 
 ifeq ($(CONFIG_ESP32S3_I2C),y)
diff --git a/arch/xtensa/src/esp32s3/esp32s3_adc.c b/arch/xtensa/src/esp32s3/esp32s3_adc.c
index ce87f13ff40..5eea37575d5 100644
--- a/arch/xtensa/src/esp32s3/esp32s3_adc.c
+++ b/arch/xtensa/src/esp32s3/esp32s3_adc.c
@@ -37,6 +37,11 @@
 #include "esp32s3_irq.h"
 #include "esp32s3_adc.h"
 
+#include "esp_clk_tree.h"
+#include "esp_private/periph_ctrl.h"
+#include "hal/adc_oneshot_hal.h"
+#include "hal/sar_ctrl_ll.h"
+#include "soc/periph_defs.h"
 #include "xtensa.h"
 #include "hardware/esp32s3_system.h"
 #include "hardware/esp32s3_efuse.h"
@@ -165,6 +170,9 @@ static const struct adc_ops_s g_adcops =
   .ao_ioctl       = adc_ioctl,
 };
 
+static adc_oneshot_hal_ctx_t g_adc_hal;
+static bool g_adc_hal_initialized;
+
 #ifdef CONFIG_ESP32S3_ADC1_CHANNEL0
 static struct adc_chan_s g_adc1_chan0 =
 {
@@ -591,8 +599,9 @@ static void adc_calibrate(void)
 
 static void adc_read_work(struct adc_dev_s *dev)
 {
+  bool valid;
   int ret;
-  uint32_t value;
+  int value;
   int32_t adc;
   struct adc_chan_s *priv = (struct adc_chan_s *)dev->ad_priv;
 
@@ -603,8 +612,14 @@ static void adc_read_work(struct adc_dev_s *dev)
       return;
     }
 
-  adc_samplecfg(priv->channel);
-  value = adc_read();
+  adc_oneshot_hal_setup(&g_adc_hal, priv->channel);
+  valid = adc_oneshot_hal_convert(&g_adc_hal, &value);
+  if (!valid)
+    {
+      aerr("Invalid one-shot ADC read\n");
+      nxmutex_unlock(&g_lock);
+      return;
+    }
 
   adc = (int32_t)(value * (UINT16_MAX * ADC_CAL_VOL_DEF / g_cal_digit) /
                   UINT16_MAX);
@@ -695,8 +710,10 @@ out:
 
 static int adc_setup(struct adc_dev_s *dev)
 {
+  adc_oneshot_hal_cfg_t hal_config;
+  adc_oneshot_hal_chan_cfg_t channel_config;
   int ret;
-  uint32_t regval;
+  uint32_t clk_src_freq_hz = 0;
   struct adc_chan_s *priv = (struct adc_chan_s *)dev->ad_priv;
 
   ainfo("channel: %" PRIu8 "\n", priv->channel);
@@ -717,7 +734,37 @@ static int adc_setup(struct adc_dev_s *dev)
 
   ainfo("pin: %" PRIu8 "\n", priv->pin);
 
-  esp32s3_configgpio(priv->pin, INPUT | FUNCTION_1);
+  esp32s3_configgpio(priv->pin, INPUT | FUNCTION_2);
+
+  if (!g_adc_hal_initialized)
+    {
+      ret = esp_clk_tree_src_get_freq_hz(
+              ADC_DIGI_CLK_SRC_DEFAULT,
+              ESP_CLK_TREE_SRC_FREQ_PRECISION_CACHED,
+              &clk_src_freq_hz);
+      if (ret < 0)
+        {
+          adc_disable_clk();
+          aerr("Failed to get ADC clock: %d\n", ret);
+          return ret;
+        }
+
+      hal_config.unit = ADC_UNIT_1;
+      hal_config.work_mode = ADC_HAL_SINGLE_READ_MODE;
+      hal_config.clk_src = ADC_DIGI_CLK_SRC_DEFAULT;
+      hal_config.clk_src_freq_hz = clk_src_freq_hz;
+      adc_oneshot_hal_init(&g_adc_hal, &hal_config);
+
+      periph_module_enable(PERIPH_SARADC_MODULE);
+      periph_module_reset(PERIPH_SARADC_MODULE);
+      sar_ctrl_ll_set_power_mode(SAR_CTRL_LL_POWER_ON);
+      g_adc_hal_initialized = true;
+    }
+
+  channel_config.atten = ADC_ATTEN_DB_12;
+  channel_config.bitwidth = ADC_BITWIDTH_12;
+  adc_oneshot_hal_channel_config(&g_adc_hal, &channel_config,
+                                 priv->channel);
 
   /* Start calibration only once  */
 
diff --git a/arch/xtensa/src/esp32s3/esp32s3_sdmmc.c b/arch/xtensa/src/esp32s3/esp32s3_sdmmc.c
index d76eba5818c..c6f1771d365 100644
--- a/arch/xtensa/src/esp32s3/esp32s3_sdmmc.c
+++ b/arch/xtensa/src/esp32s3/esp32s3_sdmmc.c
@@ -1283,6 +1283,12 @@ static sdio_statset_t esp32s3_status(struct sdio_dev_s *dev)
     {
       priv->cdstatus &= ~SDIO_STATUS_PRESENT;
     }
+#else
+  /* Boards without a card-detect signal use a fixed SD slot.  Report the
+   * medium as present so that the MMC/SD layer can perform an actual probe.
+   */
+
+  priv->cdstatus |= SDIO_STATUS_PRESENT;
 #endif
 
   mcinfo("cdstatus=%02x\n", priv->cdstatus);
@@ -1521,14 +1527,7 @@ static void esp32s3_clock(struct sdio_dev_s *dev, enum sdio_clock_e rate)
       /* Enable in MMC normal operation clocking */
 
       case CLOCK_MMC_TRANSFER:
-        if (esp32s3_capabilities(dev) & SDIO_CAPS_MMC_HS_MODE)
-          {
-            freq_khz = 40 * 1000;
-          }
-        else
-          {
-            freq_khz = 20 * 1000;
-          }
+        freq_khz = CONFIG_ESP32S3_SDMMC_FREQUENCY / 1000;
         break;
 
       /* SD normal operation clocking (wide 4-bit mode) */
@@ -1537,7 +1536,7 @@ static void esp32s3_clock(struct sdio_dev_s *dev, enum sdio_clock_e rate)
 #ifndef CONFIG_ESP32S3_SDMMC_WIDTH_D1_ONLY
         /* TODO: Use higher frequency */
 
-        freq_khz = 20 * 1000;
+        freq_khz = CONFIG_ESP32S3_SDMMC_FREQUENCY / 1000;
         esp32s3_widebus(dev, true);
         break;
 #endif
@@ -1548,7 +1547,7 @@ static void esp32s3_clock(struct sdio_dev_s *dev, enum sdio_clock_e rate)
 
         /* TODO: Use higher frequency */
 
-        freq_khz = 20 * 1000;
+        freq_khz = CONFIG_ESP32S3_SDMMC_FREQUENCY / 1000;
         esp32s3_widebus(dev, false);
         break;
     }
diff --git a/boards/xtensa/esp32s3/esp32s3-eye/configs/blindbadge/defconfig b/boards/xtensa/esp32s3/esp32s3-eye/configs/blindbadge/defconfig
index 59b6a86c6ae..0b97aec5da6 100644
--- a/boards/xtensa/esp32s3/esp32s3-eye/configs/blindbadge/defconfig
+++ b/boards/xtensa/esp32s3/esp32s3-eye/configs/blindbadge/defconfig
@@ -14,6 +14,7 @@
 # CONFIG_ESP32S3_I2S0_TX is not set
 # CONFIG_ESP32S3_WIFI_RX_AMPDU is not set
 # CONFIG_ESP32S3_WIFI_TX_AMPDU is not set
+# CONFIG_MMCSD_HAVE_CARDDETECT is not set
 # CONFIG_NDEBUG is not set
 # CONFIG_NSH_ARGCAT is not set
 # CONFIG_NSH_CMDOPT_HEXDUMP is not set
@@ -49,6 +50,8 @@ CONFIG_DEFAULT_TASK_STACKSIZE=4096
 CONFIG_DRIVERS_AUDIO=y
 CONFIG_DRIVERS_IEEE80211=y
 CONFIG_DRIVERS_WIRELESS=y
+CONFIG_ESP32S3_ADC1_CHANNEL0=y
+CONFIG_ESP32S3_ADC=y
 CONFIG_ESP32S3_CAM=y
 CONFIG_ESP32S3_EYE_LCD=y
 CONFIG_ESP32S3_I2C0=y
@@ -66,6 +69,9 @@ CONFIG_ESP32S3_LEDC_CHANNEL0_PIN=15
 CONFIG_ESP32S3_LEDC_TIM0=y
 CONFIG_ESP32S3_LEDC_TIM0_CHANNELS=1
 CONFIG_ESP32S3_RT_TIMER_TASK_STACK_SIZE=4096
+CONFIG_ESP32S3_SDMMC=y
+CONFIG_ESP32S3_SDMMC_CMD=38
+CONFIG_ESP32S3_SDMMC_FREQUENCY=10000000
 CONFIG_ESP32S3_SPI2_CLKPIN=21
 CONFIG_ESP32S3_SPI2_CSPIN=44
 CONFIG_ESP32S3_SPI2_MISOPIN=1
@@ -81,6 +87,7 @@ CONFIG_EXAMPLES_AI_AGENT_VELA_NODE_DISPLAY_NAME="BlindBadge ESP32-S3-EYE"
 CONFIG_EXAMPLES_AI_AGENT_VELA_NODE_ID="blind-badge-esp32s3"
 CONFIG_EXAMPLES_DHCPD=y
 CONFIG_EXAMPLES_RANDOM=y
+CONFIG_FS_FAT=y
 CONFIG_FS_PROCFS=y
 CONFIG_FS_ROMFS=y
 CONFIG_FS_TMPFS=y
@@ -102,6 +109,8 @@ CONFIG_LCD_ST7789_FREQUENCY=40000000
 CONFIG_LCD_ST7789_YRES=240
 CONFIG_LIBC_SEM_MUTEX_NOINLINE=y
 CONFIG_LVX_USE_DEMO_CONTEST2026_024_BLIND_BADGE_APP=y
+CONFIG_MMCSD_CHECK_READY_STATUS_WITHOUT_SLEEP=y
+CONFIG_MMCSD_MULTIBLOCK_LIMIT=128
 CONFIG_MM_REGIONS=2
 CONFIG_NAME_MAX=48
 CONFIG_NETDB_DNSCLIENT=y
@@ -146,6 +155,7 @@ CONFIG_RR_INTERVAL=200
 CONFIG_SCHED_HPWORKPRIORITY=254
 CONFIG_SCHED_LPWORK=y
 CONFIG_SCHED_WAITPID=y
+CONFIG_SDIO_WIDTH_D1_ONLY=y
 CONFIG_SIG_DEFAULT=y
 CONFIG_START_DAY=6
 CONFIG_START_MONTH=12
diff --git a/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_boot.c b/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_boot.c
index 86f4e3dae95..5d3361e65be 100644
--- a/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_boot.c
+++ b/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_boot.c
@@ -27,8 +27,6 @@
 #include <nuttx/config.h>
 
 #include <debug.h>
-#include <sched.h>
-
 #include <nuttx/board.h>
 #include <nuttx/mm/mm.h>
 #include <arch/board/board.h>
@@ -77,41 +75,10 @@ void esp32s3_board_initialize(void)
  ****************************************************************************/
 
 #ifdef CONFIG_BOARD_LATE_INITIALIZE
-#ifdef CONFIG_LVX_USE_DEMO_CONTEST2026_024_BLIND_BADGE_APP
-extern int blind_badge_app_main(int argc, FAR char *argv[]);
-
-static void esp32s3_start_blindbadge_task(FAR const char *name,
-                                          int priority,
-                                          FAR char *argv[])
-{
-  /* Start board services before NSH touches the USB console. */
-
-  task_create(name, priority, 16384,
-              blind_badge_app_main, argv);
-}
-#endif
-
 void board_late_initialize(void)
 {
   /* Perform board-specific initialization */
 
   esp32s3_bringup();
-
-#ifdef CONFIG_LVX_USE_DEMO_CONTEST2026_024_BLIND_BADGE_APP
-  FAR char *vision_argv[] =
-    {
-      "vision_server", "80", NULL
-    };
-
-  FAR char *button_argv[] =
-    {
-      "button_service", NULL
-    };
-
-  esp32s3_start_blindbadge_task("bb_vision", SCHED_PRIORITY_DEFAULT + 2,
-                                vision_argv);
-  esp32s3_start_blindbadge_task("bb_button", SCHED_PRIORITY_DEFAULT + 1,
-                                button_argv);
-#endif
 }
 #endif
diff --git a/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_bringup.c b/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_bringup.c
index 84ad2edadf6..2c897862dbc 100644
--- a/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_bringup.c
+++ b/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_bringup.c
@@ -28,6 +28,7 @@
 
 #include <stdio.h>
 #include <fcntl.h>
+#include <sched.h>
 #include <unistd.h>
 #include <syslog.h>
 #include <sys/stat.h>
@@ -64,6 +65,10 @@
 #  include "esp32s3_i2c.h"
 #endif
 
+#ifdef CONFIG_ESP32S3_ADC
+#  include "esp32s3_board_adc.h"
+#endif
+
 #ifdef CONFIG_WATCHDOG
 #  include "esp32s3_board_wdt.h"
 #endif
@@ -87,6 +92,22 @@
 
 #include "esp32s3-eye.h"
 
+#ifdef CONFIG_LVX_USE_DEMO_CONTEST2026_024_BLIND_BADGE_APP
+extern int blind_badge_app_main(int argc, FAR char *argv[]);
+
+static void esp32s3_start_blindbadge_button(void)
+{
+  FAR char *button_argv[] =
+    {
+      "button_service", NULL
+    };
+
+  task_create("bb_button", SCHED_PRIORITY_DEFAULT + 1, 16384,
+              blind_badge_app_main, button_argv);
+}
+
+#endif
+
 /****************************************************************************
  * Public Functions
  ****************************************************************************/
@@ -196,6 +217,16 @@ int esp32s3_bringup(void)
 #endif
 
 #ifdef CONFIG_INPUT_BUTTONS
+  /* GPIO1 carries the ESP32-S3-EYE MENU/PLAY/DN-/UP+ ADC ladder. */
+
+#ifdef CONFIG_ESP32S3_ADC
+  ret = board_adc_init();
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "Failed to initialize button ADC: %d\n", ret);
+    }
+#endif
+
   /* Register the BUTTON driver */
 
   ret = btn_lower_initialize("/dev/buttons");
@@ -284,6 +315,15 @@ int esp32s3_bringup(void)
     }
 #endif
 
+#ifdef CONFIG_LVX_USE_DEMO_CONTEST2026_024_BLIND_BADGE_APP
+  /* Start DN handling as soon as its ADC, WLAN, display and SD dependencies
+   * are ready.  Camera initialization below can take several seconds; if the
+   * task is started after it, an early post-reset DN click is lost.
+   */
+
+  esp32s3_start_blindbadge_button();
+#endif
+
 #ifdef CONFIG_ESP32S3_CAM
   ret = board_camera_initialize();
   if (ret < 0)
-- 
