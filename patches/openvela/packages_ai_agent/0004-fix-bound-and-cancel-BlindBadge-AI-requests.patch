+static int tls_tcp_connect(tls_ctx_t* ctx, const char* host,
+    const char* port, int timeout_sec)
+{
+    struct addrinfo hints;
+    struct addrinfo* addresses = NULL;
+    struct addrinfo* address;
+    int last_error = 0;
+    int ret;
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_protocol = IPPROTO_TCP;
+
+    ret = getaddrinfo(host, port, &hints, &addresses);
+    if (ret != 0 || addresses == NULL) {
+        syslog(LOG_ERR, "[%s] DNS lookup failed for %s:%s: %d\n",
+            TAG, host, port, ret);
+        errno = EHOSTUNREACH;
+        return -1;
+    }
+
+    for (address = addresses; address != NULL;
+         address = address->ai_next) {
+        fd_set writefds;
+        struct timeval timeout;
+        socklen_t error_len;
+        int error = 0;
+        int flags;
+        int fd;
+
+        fd = socket(address->ai_family, address->ai_socktype,
+            address->ai_protocol);
+        if (fd < 0) {
+            last_error = errno;
+            continue;
+        }
+
+        flags = fcntl(fd, F_GETFL, 0);
+        if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) {
+            last_error = errno;
+            close(fd);
+            continue;
+        }
+
+        /* Publish the fd before waiting so a service cancellation can close
+         * the in-progress connection through vela_tls_abort_active(). */
+
+        ctx->net.fd = fd;
+        ret = connect(fd, address->ai_addr, address->ai_addrlen);
+        if (ret < 0 && errno != EINPROGRESS) {
+            last_error = errno;
+            close(fd);
+            ctx->net.fd = -1;
+            continue;
+        }
+
+        if (ret < 0) {
+            FD_ZERO(&writefds);
+            FD_SET(fd, &writefds);
+            timeout.tv_sec = timeout_sec;
+            timeout.tv_usec = 0;
+
+            ret = select(fd + 1, NULL, &writefds, NULL, &timeout);
+            if (ctx->net.fd != fd) {
+                last_error = ECANCELED;
+                break;
+            }
+
+            if (ret <= 0) {
+                last_error = ret == 0 ? ETIMEDOUT : errno;
+                close(fd);
+                ctx->net.fd = -1;
+                continue;
+            }
+
+            error_len = sizeof(error);
+            if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &error,
+                    &error_len) < 0 || error != 0) {
+                last_error = error != 0 ? error : errno;
+                close(fd);
+                ctx->net.fd = -1;
+                continue;
+            }
+        }
+
+        if (fcntl(fd, F_SETFL, flags) < 0) {
+            last_error = errno;
+            close(fd);
+            ctx->net.fd = -1;
+            continue;
+        }
+
+        freeaddrinfo(addresses);
+        return 0;
+    }
+
+    freeaddrinfo(addresses);
+    errno = last_error;
+    return -1;
+}
