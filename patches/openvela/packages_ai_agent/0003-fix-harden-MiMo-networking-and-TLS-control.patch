diff --git a/src/infra/network_manager.c b/src/infra/network_manager.c
index 71768df..9857e96 100644
--- a/src/infra/network_manager.c
+++ b/src/infra/network_manager.c
@@ -165,6 +165,12 @@ int network_wifi_reconnect(void)
     return network_wait_connected(5000);
 }
 
+int network_wifi_disconnect(const char* iface)
+{
+    (void)iface;
+    return system("ifdown eth0") == 0 ? OK : ERROR;
+}
+
 #elif defined(CONFIG_AI_AGENT_NET_RPMSG)
 /* ── RPMSG/TUN network via BLE proxy ─────────────────────────── */
 
@@ -792,6 +798,12 @@ int network_wifi_reconnect(void)
     return network_rpmsg_init();
 }
 
+int network_wifi_disconnect(const char* iface)
+{
+    (void)iface;
+    return ERROR;
+}
+
 #else
 /* Real hardware: use the board-supported NuttX WAPI command sequence. */
 #include "infra/config_store.h"
@@ -891,4 +903,30 @@ int network_wifi_reconnect(void)
     agent_config_get(AGENT_CFG_KEY_WIFI_PASS, pass, sizeof(pass));
     return network_wifi_connect(NULL, ssid, pass);
 }
+
+int network_wifi_disconnect(const char* iface)
+{
+    const char* dev = (iface && iface[0]) ? iface : "wlan0";
+    struct in_addr no_addr = { .s_addr = INADDR_ANY };
+    int sock;
+    int ret;
+
+    pthread_mutex_lock(&s_wifi_connect_mutex);
+    sock = wapi_make_socket();
+    if (sock < 0) {
+        pthread_mutex_unlock(&s_wifi_connect_mutex);
+        return ERROR;
+    }
+
+    ret = wapi_set_essid(sock, dev, "", WAPI_ESSID_OFF);
+    close(sock);
+    netlib_set_ipv4addr(dev, &no_addr);
+    netlib_set_dripv4addr(dev, &no_addr);
+    netlib_set_ipv4netmask(dev, &no_addr);
+    if (netlib_ifdown(dev) != OK)
+        ret = ERROR;
+    pthread_mutex_unlock(&s_wifi_connect_mutex);
+
+    return ret == OK ? OK : ERROR;
+}
 #endif
