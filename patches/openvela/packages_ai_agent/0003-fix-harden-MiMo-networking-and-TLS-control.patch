diff --git a/src/infra/vela_tls.c b/src/infra/vela_tls.c
index f04bdf2..83e939b 100644
--- a/src/infra/vela_tls.c
+++ b/src/infra/vela_tls.c
@@ -61,6 +61,8 @@ static int simple_entropy_func(void* data, unsigned char* output, size_t len)
 
 static const char* TAG = "vela_tls";
 
+#define VELA_TLS_HANDSHAKE_TIMEOUT_SEC 15
+
 /* ── Chunked transfer decoding ───────────────────────────────── */
 
 /**
@@ -212,6 +214,7 @@ static conn_slot_t* pool_acquire(const char* host, const char* port)
     /* 2. Find an empty slot */
     for (int i = 0; i < CONN_POOL_SIZE; i++) {
         if (!s_pool[i].valid && !s_pool[i].in_use) {
+            s_pool[i].ctx.net.fd = -1;
             s_pool[i].in_use = true;
             pthread_mutex_unlock(&s_pool_lock);
             return &s_pool[i];
@@ -268,8 +271,21 @@ void vela_tls_pool_cleanup(void)
     pthread_mutex_unlock(&s_pool_lock);
 }
 
+void vela_tls_abort_active(void)
+{
+    pthread_mutex_lock(&s_pool_lock);
+    for (int i = 0; i < CONN_POOL_SIZE; i++) {
+        if (s_pool[i].in_use && s_pool[i].ctx.net.fd >= 0) {
+            shutdown(s_pool[i].ctx.net.fd, SHUT_RDWR);
+        }
+    }
+    pthread_mutex_unlock(&s_pool_lock);
+}
+
 static int tls_ctx_connect(tls_ctx_t* ctx, const char* host, const char* port)
 {
+    int handshake_timeout_sec = VELA_TLS_HANDSHAKE_TIMEOUT_SEC;
+    int read_timeout_sec = AGENT_LLM_SOCKET_TIMEOUT_SEC;
     int ret;
 
     mbedtls_ssl_init(&ctx->ssl);
@@ -322,13 +338,19 @@ static int tls_ctx_connect(tls_ctx_t* ctx, const char* host, const char* port)
         if ((ret = mbedtls_net_connect(&ctx->net, host, port,
                  MBEDTLS_NET_PROTO_TCP))
             != 0) {
+            fprintf(stderr,
+                "[ai_agent] TCP connect %s:%s failed: mbedtls=-0x%04x errno=%d\n",
+                host, port, -ret, errno);
             syslog(LOG_ERR, "[%s] net_connect %s:%s ret=0x%x\n",
                 TAG, host, port, -ret);
             return VELA_TLS_ERR_CONNECT;
         }
     }
 
-    /* Force blocking mode and set socket-level read timeout.
+    /* Force blocking mode and use the shorter connect timeout while the TLS
+     * handshake is in progress.  A timed-out blocking recv is reported by
+     * mbedTLS as WANT_READ, so the handshake loop below also has an explicit
+     * deadline instead of retrying WANT_READ forever.
      * This avoids using select()/poll() inside mbedtls_net_recv_timeout
      * which returns MBEDTLS_ERR_NET_POLL_FAILED (-0x0047) on NuttX/QEMU.
      * Timeout is configured via AGENT_LLM_SOCKET_TIMEOUT_SEC in
@@ -337,21 +359,13 @@ static int tls_ctx_connect(tls_ctx_t* ctx, const char* host, const char* port)
     mbedtls_net_set_block(&ctx->net);
     if (ctx->net.fd >= 0) {
 #ifdef CONFIG_AI_AGENT_NET_RPMSG
-        int read_timeout_sec = network_get_read_timeout();
-        struct timeval tv = { .tv_sec = read_timeout_sec, .tv_usec = 0 };
-#else
-        struct timeval tv = { .tv_sec = AGENT_LLM_SOCKET_TIMEOUT_SEC,
-            .tv_usec = 0 };
+        handshake_timeout_sec = network_get_connect_timeout();
+        read_timeout_sec = network_get_read_timeout();
 #endif
+        struct timeval tv = { .tv_sec = handshake_timeout_sec,
+            .tv_usec = 0 };
         setsockopt(ctx->net.fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
-
-#ifdef CONFIG_AI_AGENT_NET_RPMSG
-        {
-            int timeout_sec = network_get_connect_timeout();
-            struct timeval ctv = { .tv_sec = timeout_sec, .tv_usec = 0 };
-            setsockopt(ctx->net.fd, SOL_SOCKET, SO_SNDTIMEO, &ctv, sizeof(ctv));
-        }
-#endif
+        setsockopt(ctx->net.fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
     }
 
     /* SSL config: client, TLS, default ciphersuites */
@@ -412,7 +426,25 @@ static int tls_ctx_connect(tls_ctx_t* ctx, const char* host, const char* port)
         mbedtls_net_send, mbedtls_net_recv, NULL);
 
     /* Handshake */
+    struct timespec handshake_deadline;
+    clock_gettime(CLOCK_MONOTONIC, &handshake_deadline);
+    handshake_deadline.tv_sec += handshake_timeout_sec;
     while ((ret = mbedtls_ssl_handshake(&ctx->ssl)) != 0) {
+        if (ret == MBEDTLS_ERR_SSL_WANT_READ ||
+            ret == MBEDTLS_ERR_SSL_WANT_WRITE) {
+            struct timespec current_time;
+
+            clock_gettime(CLOCK_MONOTONIC, &current_time);
+            if (current_time.tv_sec > handshake_deadline.tv_sec ||
+                (current_time.tv_sec == handshake_deadline.tv_sec &&
+                 current_time.tv_nsec >= handshake_deadline.tv_nsec)) {
+                syslog(LOG_ERR, "[%s] TLS handshake timed out after %ds\n",
+                    TAG, handshake_timeout_sec);
+                return VELA_TLS_ERR_HANDSHAKE;
+            }
+            continue;
+        }
+
         if (ret != MBEDTLS_ERR_SSL_WANT_READ && ret != MBEDTLS_ERR_SSL_WANT_WRITE) {
 #if defined(MBEDTLS_ERROR_C)
             char err_buf[128];
@@ -429,6 +461,12 @@ static int tls_ctx_connect(tls_ctx_t* ctx, const char* host, const char* port)
         }
     }
 
+    if (ctx->net.fd >= 0) {
+        struct timeval tv = { .tv_sec = read_timeout_sec, .tv_usec = 0 };
+
+        setsockopt(ctx->net.fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    }
+
     syslog(LOG_INFO, "[%s] Handshake OK: %s / %s\n", TAG, mbedtls_ssl_get_version(&ctx->ssl),
         mbedtls_ssl_get_ciphersuite(&ctx->ssl));
 
