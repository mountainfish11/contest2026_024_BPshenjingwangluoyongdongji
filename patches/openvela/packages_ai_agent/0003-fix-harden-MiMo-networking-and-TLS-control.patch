+void vela_tls_abort_active(void);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/llm/llm_proxy.c b/src/llm/llm_proxy.c
index b775608..14f7abf 100644
--- a/src/llm/llm_proxy.c
+++ b/src/llm/llm_proxy.c
@@ -56,6 +56,16 @@ bool is_openai_compat_host(const char* host)
         || strstr(host, "xiaomimimo.com");
 }
 
+/* MiMo Token Plan follows the OpenAI-compatible request body, but its
+ * gateway authenticates with `api-key: <key>` instead of
+ * `Authorization: Bearer <key>`.  Keep Bearer authentication for every
+ * other provider.
+ */
+static bool is_xiaomi_mimo_host(const char* host)
+{
+    return host && strstr(host, "xiaomimimo.com") != NULL;
+}
+
 
 static void add_mimo_thinking_disabled(cJSON* body, const char* host)
 {
@@ -269,9 +279,13 @@ static int llm_http_direct(const char* post_data, resp_buf_t* rb,
     if (resp_buf_init(rb, raw_cap) != OK)
         return ERROR;
 
-    /* OpenAI-compatible format: Authorization: Bearer <key> */
+    /* MiMo Token Plan requires the raw key in an api-key header. */
+    const bool mimo_auth = is_xiaomi_mimo_host(llm_host);
     char auth_header[256];
-    snprintf(auth_header, sizeof(auth_header), "Bearer %s", api_key);
+    if (mimo_auth)
+        snprintf(auth_header, sizeof(auth_header), "%s", api_key);
+    else
+        snprintf(auth_header, sizeof(auth_header), "Bearer %s", api_key);
 
     /* Extract provider ID from model string (e.g. "xiaomi/mimo-claw-0301" →
      * "xiaomi") Mify gateway requires X-Model-Provider-Id header for routing. */
@@ -284,7 +298,8 @@ static int llm_http_direct(const char* post_data, resp_buf_t* rb,
         memcpy(provider, model, plen);
     }
 
-    vela_header_t hdrs[] = { { "Authorization", auth_header },
+    vela_header_t hdrs[] = { { mimo_auth ? "api-key" : "Authorization",
+                                  auth_header },
         { provider[0] ? "X-Model-Provider-Id" : NULL,
             provider[0] ? provider : NULL },
         { NULL, NULL } };
@@ -301,6 +316,8 @@ static int llm_http_direct(const char* post_data, resp_buf_t* rb,
     }
 
     if (status < 0) {
+        fprintf(stderr, "[ai_agent] MiMo HTTPS failed at %s:%s%s: %d\n",
+            llm_host, llm_port, llm_path, status);
         resp_buf_free(rb);
         return ERROR;
     }
@@ -335,8 +352,12 @@ static int llm_http_via_proxy(const char* post_data, resp_buf_t* rb,
         return ERROR;
 
     int body_len = (int)strlen(post_data);
+    const bool mimo_auth = is_xiaomi_mimo_host(llm_host);
     char auth_header[256];
-    snprintf(auth_header, sizeof(auth_header), "Bearer %s", api_key);
+    if (mimo_auth)
+        snprintf(auth_header, sizeof(auth_header), "%s", api_key);
+    else
+        snprintf(auth_header, sizeof(auth_header), "Bearer %s", api_key);
 
     /* Extract provider ID from model (e.g. "xiaomi/mimo-claw-0301" → "xiaomi") */
     char provider_hdr[128] = { 0 };
@@ -356,11 +377,12 @@ static int llm_http_via_proxy(const char* post_data, resp_buf_t* rb,
         "POST %s HTTP/1.1\r\n"
         "Host: %s\r\n"
         "Content-Type: application/json\r\n"
-        "Authorization: %s\r\n"
+        "%s: %s\r\n"
         "%s"
         "Content-Length: %d\r\n"
         "Connection: close\r\n\r\n",
-        llm_path, llm_host, auth_header, provider_hdr, body_len);
+        llm_path, llm_host, mimo_auth ? "api-key" : "Authorization",
+        auth_header, provider_hdr, body_len);
 
     if (proxy_conn_write(conn, header, hlen) < 0 || proxy_conn_write(conn, post_data, body_len) < 0) {
         proxy_conn_close(conn);
