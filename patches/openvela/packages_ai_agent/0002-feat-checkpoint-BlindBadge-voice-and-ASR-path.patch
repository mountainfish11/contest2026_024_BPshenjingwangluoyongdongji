+static void trim_secret(char* text)
+{
+    size_t len;
+
+    if (text == NULL) {
+        return;
+    }
+
+    while (*text == ' ' || *text == '\t' || *text == '\r' || *text == '\n') {
+        memmove(text, text + 1, strlen(text));
+    }
+
+    len = strlen(text);
+    while (len > 0 && (text[len - 1] == ' ' || text[len - 1] == '\t'
+           || text[len - 1] == '\r' || text[len - 1] == '\n')) {
+        text[--len] = '\0';
+    }
+}
+
+static int read_secret_file(const char* path, char* out, size_t out_size)
