+int ai_agent_wifi_reconnect(void)
+{
+    int err;
+
+    /* A build-local configuration is the authoritative boot configuration.
+     * Trying stale persisted credentials first can double the boot timeout. */
+    if (AI_AGENT_LOCAL_WIFI_SSID[0] != '\0') {
+        return network_wifi_connect_boot(NULL, AI_AGENT_LOCAL_WIFI_SSID,
+            AI_AGENT_LOCAL_WIFI_PASSWORD);
+    }
+
+    /* Persisted credentials require the config store.  Keep this off the
+     * compile-time local credential path so physical reset can start Wi-Fi
+     * immediately even when storage initialization is slow. */
+    config_store_init();
+    err = network_wifi_reconnect();
+    return err;
+}
