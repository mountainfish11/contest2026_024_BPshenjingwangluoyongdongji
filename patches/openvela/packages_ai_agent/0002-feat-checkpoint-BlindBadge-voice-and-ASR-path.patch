+static void cmd_ask_direct(int argc, char** argv)
+{
+    if (argc < 2) {
+        printf("Usage: ask <message>\n");
+        return;
+    }
+
+    char content[256] = { 0 };
+    for (int i = 1; i < argc; i++) {
+        strncat(content, argv[i], sizeof(content) - strlen(content) - 1);
+        if (i < argc - 1)
+            strncat(content, " ", sizeof(content) - strlen(content) - 1);
+    }
+
+    int idx = llm_router_select(LLM_COMPLEXITY_SIMPLE);
+    if (idx < 0 || llm_router_apply(idx) != 0) {
+        printf("Error: no available LLM router backend\n");
+        if (ai_agent_display_ask_result) {
+            ai_agent_display_ask_result("No AI backend", 0);
+        }
+        return;
+    }
+
+    char messages_json[384];
+    char response[512] = { 0 };
+    struct timespec t0;
+    struct timespec t1;
+
+    snprintf(messages_json, sizeof(messages_json),
+        "[{\"role\":\"user\",\"content\":\"%s\"}]", content);
+
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    int rc = llm_chat("You are a concise assistant. Reply briefly.",
+        messages_json, response, sizeof(response));
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+
+    uint32_t latency_ms = (uint32_t)((t1.tv_sec - t0.tv_sec) * 1000L
+        + (t1.tv_nsec - t0.tv_nsec) / 1000000L);
+
+    if (rc == OK) {
+        llm_router_report_success(idx);
+        llm_router_report_latency(idx, latency_ms);
+        printf("%s\n", response);
+        if (ai_agent_display_ask_result) {
+            ai_agent_display_ask_result(response, 1);
+        }
+    } else {
+        const char* error = response[0] ? response : "Error: llm_chat failed";
+        llm_router_report_failure(idx);
+        printf("%s\n", error);
+        if (ai_agent_display_ask_result) {
+            ai_agent_display_ask_result(error, 0);
+        }
+    }
+}
