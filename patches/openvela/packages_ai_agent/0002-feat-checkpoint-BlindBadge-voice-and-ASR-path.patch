+static void configure_local_mimo_fallback(void)
+{
+    llm_backend_t current;
+
+    for (int i = 0; i < LLM_ROUTER_MAX_BACKENDS; i++) {
+        if (llm_router_get_backend(i, &current) == OK) {
+            return;
+        }
+    }
+
+    if (AI_AGENT_LOCAL_MIMO_KEY[0] == '\0') {
+        return;
+    }
+
+    llm_backend_t backend = { 0 };
+    strncpy(backend.host, AGENT_LLM_MIMO_HOST, sizeof(backend.host) - 1);
+    strncpy(backend.path, AGENT_LLM_MIMO_PATH, sizeof(backend.path) - 1);
+    strncpy(backend.port, "443", sizeof(backend.port) - 1);
+    strncpy(backend.model, AGENT_LLM_MIMO_MODEL, sizeof(backend.model) - 1);
+    strncpy(backend.api_key, AI_AGENT_LOCAL_MIMO_KEY,
+        sizeof(backend.api_key) - 1);
+    backend.priority = 0;
+    backend.cost_tier = 1;
+    backend.enabled = true;
+
+    if (llm_router_set_backend_runtime(0, &backend) == OK) {
+        syslog(LOG_INFO, "[%s] Local MiMo fallback enabled\n", TAG);
+    }
+
+    memset(&backend, 0, sizeof(backend));
+}
