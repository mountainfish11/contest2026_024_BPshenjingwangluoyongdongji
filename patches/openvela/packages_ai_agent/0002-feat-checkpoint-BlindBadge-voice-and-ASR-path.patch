+static bool chunked_message_complete(const char* buf, size_t len)
+{
+    size_t pos = 0;
+
+    while (pos < len) {
+        const char* line_end = memmem(buf + pos, len - pos, "\r\n", 2);
+        if (!line_end)
+            return false;
+
+        char* endptr;
+        long chunk_size = strtol(buf + pos, &endptr, 16);
+        if (endptr == buf + pos || chunk_size < 0 || endptr > line_end)
+            return false;
+
+        while (endptr < line_end && (*endptr == ' ' || *endptr == '\t'))
+            endptr++;
+        if (endptr < line_end && *endptr != ';')
+            return false;
+
+        size_t data_pos = (size_t)(line_end - buf) + 2;
+        if (chunk_size == 0) {
+            return memmem(line_end, len - (size_t)(line_end - buf),
+                       "\r\n\r\n", 4)
+                != NULL;
+        }
+
+        if ((size_t)chunk_size > len - data_pos
+            || data_pos + (size_t)chunk_size + 2 > len)
+            return false;
+
+        pos = data_pos + (size_t)chunk_size;
+        if (buf[pos] != '\r' || buf[pos + 1] != '\n')
+            return false;
+        pos += 2;
+    }
+
+    return false;
+}
