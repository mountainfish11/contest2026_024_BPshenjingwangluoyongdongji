+            BOOT_LOG_RC(&t0, "P2-direct", "http_proxy_init", rc);
+
+            rc = llm_proxy_init();
+            BOOT_LOG_RC(&t0, "P3-direct", "llm_proxy_init", rc);
+
+            rc = llm_router_init();
+            BOOT_LOG_RC(&t0, "P3-direct", "llm_router_init", rc);
