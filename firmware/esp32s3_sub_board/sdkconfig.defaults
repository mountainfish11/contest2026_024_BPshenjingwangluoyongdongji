# ESP32-S3 Sub Board default configuration
CONFIG_IDF_TARGET="esp32s3"

# WiFi Configuration
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SUB_BOARD_WIFI_SSID=""
CONFIG_SUB_BOARD_WIFI_PASSWORD=""

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# GPIO19/20 run the native USB OTG peripheral in Host mode for FY-SP701.
# Keep the interactive debug console on UART0 to avoid an internal-PHY clash.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ESP32-S3-WROOM-1-N16R8 external RAM.  Keep ordinary malloc() internal;
# large audio/network buffers opt in with MALLOC_CAP_SPIRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# CONFIG_SPIRAM_MEMTEST is not set

# ATGM336H GNSS (module TXD -> GPIO4, module RXD <- GPIO5, PPS -> GPIO6)
CONFIG_ATGM336H_UART_NUM=1
CONFIG_ATGM336H_UART_BAUD_RATE=9600
CONFIG_ATGM336H_UART_RX_GPIO=4
CONFIG_ATGM336H_UART_TX_GPIO=5
CONFIG_ATGM336H_PPS_GPIO=6

# M100M 4G UART transparent link (module TXD -> GPIO15, module RXD <- GPIO16)
CONFIG_M100M_UART_NUM=2
CONFIG_M100M_UART_BAUD_RATE=115200
CONFIG_M100M_UART_RX_GPIO=15
CONFIG_M100M_UART_TX_GPIO=16

# MAX30102 pulse oximeter (I2C: SDA=GPIO8, SCL=GPIO9, INT=GPIO10)
CONFIG_MAX30102_I2C_PORT=0
CONFIG_MAX30102_SDA_GPIO=8
CONFIG_MAX30102_SCL_GPIO=9
CONFIG_MAX30102_INT_GPIO=10
CONFIG_MAX30102_I2C_FREQUENCY=400000
CONFIG_MAX30102_LED_AMPLITUDE=0x24
CONFIG_MAX30102_FINGER_THRESHOLD=80000

# 1027 vibration motor external driver control (GPIO11 -> MOSFET/base input)
CONFIG_VIBRATION_MOTOR_GPIO=11
CONFIG_VIBRATION_MOTOR_ACTIVE_HIGH=y

# Partition Table (16 MB flash; ESP-TTS voice data lives outside the app)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
