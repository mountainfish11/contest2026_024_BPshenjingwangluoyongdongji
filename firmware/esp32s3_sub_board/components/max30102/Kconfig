menu "MAX30102 Heart Rate and SpO2 Sensor Configuration"

    config MAX30102_I2C_PORT
        int "I2C controller"
        default 0
        range 0 1

    config MAX30102_SDA_GPIO
        int "SDA GPIO"
        default 8

    config MAX30102_SCL_GPIO
        int "SCL GPIO"
        default 9

    config MAX30102_INT_GPIO
        int "Active-low interrupt GPIO"
        default 10

    config MAX30102_I2C_FREQUENCY
        int "I2C frequency (Hz)"
        default 400000
        range 100000 400000

    config MAX30102_LED_AMPLITUDE
        hex "Red/IR LED pulse amplitude"
        default 0x24
        range 0x01 0xff
        help
            Each step is approximately 0.2 mA. Start conservatively and tune
            only after inspecting the RED and IR raw values.

    config MAX30102_FINGER_THRESHOLD
        int "IR finger-present threshold"
        default 50000
        range 1000 262143

endmenu
